<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dell BIOS Package Builder v3" Width="1000" Height="820" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F3F5FA" Foreground="#14213D"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="38"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,12,0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="16,12"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#14213D" Padding="28,22">
      <StackPanel>
        <TextBlock Text="DEVICE CARE / PACKAGING" Foreground="#BBD3FF" FontWeight="SemiBold" FontSize="12"/>
        <TextBlock Text="Build your Dell BIOS deployment" Foreground="White" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,5"/>
        <TextBlock Text="Your approved BIOS. Your PSADT 4.1 framework. One repeatable package." Foreground="#E1E8F5"/>
      </StackPanel>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="1" Margin="22,16,22,10" Background="White">
      <TabItem Header="1  Files"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="FilesPanel" Margin="22"/></ScrollViewer></TabItem>
      <TabItem Header="2  Deployment"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DeploymentPanel" Margin="22"/></ScrollViewer></TabItem>
      <TabItem Header="3  Experience"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ExperiencePanel" Margin="22"/></ScrollViewer></TabItem>
      <TabItem Header="4  Build"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="22">
        <TextBlock Text="Review and build" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Text="The builder does not run the BIOS updater. Test each model, firmware version and customized framework on Windows before deployment." Margin="0,10,0,14"/>
        <Border Background="#F3F5FA" CornerRadius="10" Padding="18"><TextBlock x:Name="ReviewText" FontFamily="Consolas" FontSize="13"/></Border>
        <CheckBox x:Name="Reviewed" AutomationProperties.Name="Confirm package review">
          <TextBlock Text="I reviewed Dell compatibility, prerequisite versions and the trusted PSADT template. These settings are approved for a pilot."/>
        </CheckBox>
        <TextBlock Text="The package contains the shared BIOS password in a local data file. Output is restricted to your Windows account, SYSTEM and Administrators. Protect both Source and .intunewin; do not upload them to Git." FontSize="13" Foreground="#475569" Margin="0,8,0,12"/>
        <WrapPanel><Button x:Name="BuildButton" Content="_Build package" Background="#2457D6" Foreground="White" FontWeight="SemiBold"/><Button x:Name="OpenButton" Content="Open _output" IsEnabled="False"/></WrapPanel>
        <ProgressBar x:Name="Progress" Height="5" Margin="0,16,0,10" Visibility="Collapsed"/>
        <TextBox x:Name="BuildLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Build status" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Row="2" BorderBrush="#DFE5EF" BorderThickness="0,1,0,0" Padding="20,9" Background="White">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Presets save settings only. Enter the password again for each build." Foreground="#475569" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <WrapPanel Grid.Column="1"><Button x:Name="LoadButton" Content="_Load preset"/><Button x:Name="SaveButton" Content="_Save preset"/><Button x:Name="CloseButton" Content="_Close" AutomationProperties.Name="Close package builder" ToolTip="Close the builder. A running build finishes and cleans up before closing."/></WrapPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
