<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device care" Width="600" Height="560" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="#F3F5FA" Foreground="#14213D" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,8,6"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="ContentScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="22,18,22,10">
        <DockPanel Margin="0,0,0,12">
          <Border Width="34" Height="34" Background="#2457D6" CornerRadius="9" DockPanel.Dock="Left" x:Name="Mark">
            <Viewbox Margin="8"><Path Fill="White" Data="M12,0 L23,4 L23,12 C23,20 12,26 12,26 C12,26 1,20 1,12 L1,4 Z"/></Viewbox>
          </Border>
          <Image x:Name="Logo" MaxWidth="160" Height="34" Stretch="Uniform" Visibility="Collapsed" DockPanel.Dock="Left" AutomationProperties.Name="Company logo"/>
          <StackPanel Margin="10,0,0,0"><TextBlock x:Name="Company" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="DEVICE CARE / BIOS UPDATE" FontSize="10" Foreground="#475569" Margin="0,2,0,0"/></StackPanel>
        </DockPanel>
        <Image x:Name="Banner" Height="76" Stretch="UniformToFill" Visibility="Collapsed" Margin="0,0,0,12" AutomationProperties.Name="Company banner"/>
        <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock x:Name="Purpose" Foreground="#475569" Margin="0,0,0,12"/>
        <Border x:Name="StatusCard" Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,10" BorderBrush="#DFE5EF" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="Phase" FontSize="17" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="StatusText" Margin="0,6,0,0"/>
            <TextBlock x:Name="Deadline" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <TextBlock x:Name="Remaining" Foreground="#475569" Margin="0,3,0,0"/>
            <TextBlock x:Name="Scheduled" Margin="0,7,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="#EAF0FF" Padding="12" CornerRadius="8" Margin="0,0,0,10"><TextBlock x:Name="Power" Foreground="#14213D"/></Border>
        <Border x:Name="PickerCard" Visibility="Collapsed" Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,10" BorderBrush="#DFE5EF" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="Schedule your BIOS update" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock x:Name="PreparationText" Margin="0,6,0,10" Foreground="#475569"/>
            <WrapPanel>
              <StackPanel Margin="0,0,12,8"><Label Content="_Date" Target="{Binding ElementName=Day}" Padding="0,0,0,5"/><DatePicker x:Name="Day" Width="170" Height="32" AutomationProperties.Name="Scheduled restart date"/></StackPanel>
              <StackPanel Margin="0,0,8,8"><Label Content="_Hour" Target="{Binding ElementName=Hour}" Padding="0,0,0,5"/><ComboBox x:Name="Hour" Width="68" Height="32" AutomationProperties.Name="Scheduled restart hour, 24-hour time"/></StackPanel>
              <StackPanel Margin="0,0,0,8"><Label Content="_Minute" Target="{Binding ElementName=Minute}" Padding="0,0,0,5"/><ComboBox x:Name="Minute" Width="68" Height="32" AutomationProperties.Name="Scheduled restart minute"/></StackPanel>
            </WrapPanel>
            <TextBlock x:Name="TimeZone" FontSize="12" Foreground="#475569"/>
            <TextBlock Text="Choose a date and time, then click Schedule Install again to save. You can reschedule before preparation begins and before the original deadline." Margin="0,8,0,8" FontSize="12" Foreground="#475569"/>
            <Button x:Name="CancelScheduleButton" Content="_Cancel selection" HorizontalAlignment="Left" Background="White" Foreground="#14213D" BorderBrush="#CBD5E1"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="Support" FontSize="12" Foreground="#475569"/>
      </StackPanel>
    </ScrollViewer>
    <!-- Actions stay outside scrolling content so branding/scaling cannot bury them. -->
    <Border x:Name="ActionBar" Grid.Row="1" Background="White" BorderBrush="#DFE5EF" BorderThickness="0,1,0,0" Padding="18,10,12,8">
      <StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="#B42318" Margin="0,0,0,7" Visibility="Collapsed" MaxHeight="64" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Assertive"/>
        <WrapPanel>
          <Button x:Name="InstallButton" Content="_Install Now" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Background="#2457D6" Foreground="White" BorderThickness="0" AutomationProperties.Name="Install Now"/>
          <Button x:Name="ScheduleButton" Content="_Schedule Install" IsEnabled="False" Background="White" Foreground="#14213D" BorderBrush="#CBD5E1" AutomationProperties.Name="Schedule Install"/>
          <Button x:Name="DeferButton" Content="_Defer" IsEnabled="False" Background="White" Foreground="#14213D" BorderBrush="#CBD5E1" AutomationProperties.Name="Defer"/>
          <Button x:Name="RestartButton" Content="_Restart Now" Visibility="Collapsed" Background="#2457D6" Foreground="White" BorderThickness="0" AutomationProperties.Name="Restart Now"/>
          <Button x:Name="CloseButton" Content="_Close" Background="White" Foreground="#14213D" BorderBrush="#CBD5E1"/>
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
