<!-- MedelaBIOS-FileVersion: 2.3.0 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Device care"
 Width="600" Height="510" MinWidth="380" MinHeight="320" FontFamily="Segoe UI" FontSize="14"
 WindowStartupLocation="CenterScreen" ResizeMode="CanResize" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="MinHeight" Value="40"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="24">
    <Image x:Name="Logo" Height="36" MaxWidth="180" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="Company logo"/>
    <TextBlock x:Name="Company" FontWeight="SemiBold" Margin="0,8,0,14"/>
    <Image x:Name="Banner" Height="70" Stretch="UniformToFill" Visibility="Collapsed" Margin="0,0,0,12" AutomationProperties.Name="Company banner"/>
    <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TextBlock x:Name="Purpose" Margin="0,0,0,12"/>
    <Border x:Name="StatusCard" Padding="14" CornerRadius="8" Margin="0,0,0,12"><StackPanel>
     <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite"/>
     <ProgressBar x:Name="Progress" Height="8" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="BIOS preparation activity"/>
     <TextBlock x:Name="Deadline" FontWeight="SemiBold" Margin="0,10,0,0"/>
     <TextBlock x:Name="Remaining" Margin="0,5,0,0"/>
    </StackPanel></Border>
    <TextBlock x:Name="Power" Margin="0,0,0,12"/>
    <TextBlock x:Name="Support" FontSize="12"/>
   </StackPanel>
  </ScrollViewer>
  <Border x:Name="ActionBar" Grid.Row="1" Padding="24,12"><WrapPanel>
   <Button x:Name="Primary" Content="_Install Now" AutomationProperties.Name="Install Now"/>
   <Button x:Name="Secondary" Content="_Defer" AutomationProperties.Name="Defer"/>
  </WrapPanel></Border>
 </Grid>
</Window>
