<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device care" Width="780" Height="760" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="#F3F5FA" Foreground="#14213D" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="Margin" Value="0,0,10,8"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,24">
      <DockPanel Margin="0,0,0,24">
        <Border Width="42" Height="42" Background="#2457D6" CornerRadius="12" DockPanel.Dock="Left" x:Name="Mark">
          <Viewbox Margin="10"><Path Fill="White" Data="M12,0 L23,4 L23,12 C23,20 12,26 12,26 C12,26 1,20 1,12 L1,4 Z"/></Viewbox>
        </Border>
        <Image x:Name="Logo" MaxWidth="190" Height="42" Stretch="Uniform" Visibility="Collapsed" DockPanel.Dock="Left" AutomationProperties.Name="Company logo"/>
        <StackPanel Margin="12,0,0,0"><TextBlock x:Name="Company" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="DEVICE CARE / BIOS UPDATE" FontSize="11" Foreground="#475569" Margin="0,3,0,0"/></StackPanel>
      </DockPanel>
      <Image x:Name="Banner" Height="120" Stretch="UniformToFill" Visibility="Collapsed" Margin="0,0,0,20" AutomationProperties.Name="Company banner"/>
      <TextBlock x:Name="Heading" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock x:Name="Purpose" FontSize="15" Foreground="#475569" Margin="0,0,0,24"/>
      <Border x:Name="StatusCard" Background="White" CornerRadius="14" Padding="22" Margin="0,0,0,18" BorderBrush="#DFE5EF" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="Phase" FontSize="20" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock x:Name="StatusText" Margin="0,9,0,0"/>
          <TextBlock x:Name="Deadline" FontWeight="SemiBold" Margin="0,16,0,0"/>
          <TextBlock x:Name="Remaining" Foreground="#475569" Margin="0,4,0,0"/>
          <TextBlock x:Name="Scheduled" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
      <Border x:Name="PickerCard" Background="White" CornerRadius="14" Padding="22" Margin="0,0,0,18" BorderBrush="#DFE5EF" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Choose your restart time" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Use your local time. Preparation can begin up to 30 minutes earlier; save your work before then." Margin="0,7,0,16" Foreground="#475569"/>
          <WrapPanel>
            <StackPanel Margin="0,0,18,12"><Label Content="_Date" Target="{Binding ElementName=Day}" Padding="0,0,0,6"/><DatePicker x:Name="Day" Width="190" Height="34" AutomationProperties.Name="Restart date"/></StackPanel>
            <StackPanel Margin="0,0,8,12"><Label Content="_Hour" Target="{Binding ElementName=Hour}" Padding="0,0,0,6"/><ComboBox x:Name="Hour" Width="76" Height="34" AutomationProperties.Name="Restart hour, 24-hour time"/></StackPanel>
            <StackPanel Margin="0,0,18,12"><Label Content="_Minute" Target="{Binding ElementName=Minute}" Padding="0,0,0,6"/><ComboBox x:Name="Minute" Width="76" Height="34" AutomationProperties.Name="Restart minute"/></StackPanel>
          </WrapPanel>
          <TextBlock x:Name="TimeZone" FontSize="12" Foreground="#475569"/>
          <TextBlock Text="You can change your selection until preparation begins. If you do not choose a time, preparation becomes mandatory at the deadline." Margin="0,12,0,0" FontSize="12" Foreground="#475569"/>
        </StackPanel>
      </Border>
      <Border Background="#EAF0FF" Padding="16" CornerRadius="10" Margin="0,0,0,18"><TextBlock x:Name="Power" Foreground="#14213D"/></Border>
      <TextBlock x:Name="ErrorText" Foreground="#B42318" Margin="0,0,0,12" AutomationProperties.LiveSetting="Assertive"/>
      <WrapPanel>
        <Button x:Name="ScheduleButton" Content="Schedule restart" Background="#2457D6" Foreground="White" BorderThickness="0" AutomationProperties.Name="Confirm selected restart date and time"/>
        <Button x:Name="RestartButton" Content="Restart now" Visibility="Collapsed" Background="#2457D6" Foreground="White" BorderThickness="0"/>
        <Button x:Name="DeferButton" Content="Remind me later" Background="White" Foreground="#14213D" BorderBrush="#CBD5E1"/>
        <Button x:Name="CloseButton" Content="Close" Background="White" Foreground="#14213D" BorderBrush="#CBD5E1"/>
      </WrapPanel>
      <TextBlock x:Name="Support" FontSize="12" Foreground="#475569" Margin="0,12,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
